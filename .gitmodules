	url = https://github.com/jibsen/brieflz

[submodule "vendor/hcs/old/bzip3"]
	path = vendor/hcs/old/bzip3
	url = https://github.com/kspalaiologos/bzip3

[submodule "vendor/hcs/old/density"]
