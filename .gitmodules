# Vendored upstream sources (copy of the HCS mirror).
#
# 23 of these are submodules, pinned by the commit SHA in the tree and
# mapped here. Until this file existed the pins had no URL, which is
# unrecoverable: git knew the commit but not where to fetch it, so every
# clone silently got 23 empty directories.
#
# Materialise:  git submodule update --init --recursive
# Verify:       ./scripts/check-vendor.sh

[submodule "vendor/hcs/old/aqueous"]
	path = vendor/hcs/old/aqueous
	url = https://github.com/lifthrasiir/aqueous

