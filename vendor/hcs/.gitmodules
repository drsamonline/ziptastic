# Vendored upstream sources.
#
# These are submodules so the mirror stays a mirror: HCS does not claim
# authorship of the code under old/, it pins a commit of each upstream.
#
# History: until this file existed, old/ carried 23 gitlinks with NO URL
# mapping, which is unrecoverable - git recorded a commit SHA for each
# submodule but had nowhere to fetch it from, so `git submodule update
# --init` could never work and every clone saw 23 empty directories.
#
# Materialise them with:  git submodule update --init --recursive
# Verify with:            ./scripts/check-vendor.sh

[submodule "old/aqueous"]
	path = old/aqueous
	url = https://github.com/lifthrasiir/aqueous

[submodule "old/awesome-compopt"]
	path = old/awesome-compopt
	url = https://github.com/MartinEesmaa/awesome-compopt

[submodule "old/awesome-cpp"]
	path = old/awesome-cpp
	url = https://github.com/hstsethi/awesome-cpp

[submodule "old/brieflz"]
	path = old/brieflz
	url = https://github.com/jibsen/brieflz

[submodule "old/bzip3"]
	path = old/bzip3
	url = https://github.com/kspalaiologos/bzip3

[submodule "old/density"]
	path = old/density
	url = https://github.com/centaurean/density

[submodule "old/fse"]
	path = old/fse
	url = https://github.com/Cyan4973/FiniteStateEntropy

[submodule "old/heatshrink"]
	path = old/heatshrink
